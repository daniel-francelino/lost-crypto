{
  "openapi": "3.1.0",
  "info": {
    "title": "Lost Crypto API",
    "description": "Backend da plataforma Lost Crypto: bots, estrat\u00e9gias, backtests e execu\u00e7\u00e3o.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "description": "Readiness: the process is up and the database is reachable.",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health/live": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Live",
        "description": "Liveness: the process is running (no dependencies checked).",
        "operationId": "live_api_v1_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status"
          },
          "database": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "ok",
                  "unavailable"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Database"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse"
      }
    }
  },
  "tags": [
    {
      "name": "health",
      "description": "Liveness e readiness da API."
    }
  ]
}
