APP_ENV=local
LOG_LEVEL=INFO
# Exchange integrations to enable (comma separated). Must exist in exchanges/infrastructure/catalog.py.
ENABLED_EXCHANGES=binance
# Strategies to enable (comma separated TYPE_KEYs). Empty enables every strategy in strategies/catalog.py.
ENABLED_STRATEGIES=
DATABASE_URL=postgresql+asyncpg://lostcrypto:lostcrypto@localhost:5432/lostcrypto
# Live trading stays disabled. Do not enable outside a deliberate, reviewed setup.
# LIVE_TRADING_ENABLED=false

# --- Phase 4: exchange credentials and the testnet ---------------------------------------
# Bearer token required by every API endpoint except health checks. Optional only with
# APP_ENV=local; required for APP_ENV=prod; endpoints that accept exchange keys need it always.
API_TOKEN=
# Fernet key(s) encrypting stored exchange credentials (comma separated; first encrypts, all
# decrypt, so keys can be rotated). Generate one with: make master-key
CREDENTIAL_MASTER_KEYS=
# Real orders on the exchange TESTNET (fake money) are off until you turn this on for the worker.
TESTNET_TRADING_ENABLED=false
# Reconciliation with the exchange (seconds).
# RECONCILE_INTERVAL_SECONDS=60
# RECONCILE_ABSENT_AFTER_SECONDS=30
# NATIVE_STOP_POLL_SECONDS=10
