APP_ENV=local
LOG_LEVEL=INFO
# Exchange integrations to enable (comma separated). Must exist in exchanges/infrastructure/catalog.py.
ENABLED_EXCHANGES=binance
# Strategies to enable (comma separated TYPE_KEYs). Empty enables every strategy in strategies/catalog.py.
ENABLED_STRATEGIES=
DATABASE_URL=postgresql+asyncpg://lostcrypto:lostcrypto@localhost:5432/lostcrypto
# Live trading stays disabled. Do not enable outside a deliberate, reviewed setup.
# LIVE_TRADING_ENABLED=false
