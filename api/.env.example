APP_ENV=local
LOG_LEVEL=INFO
# Exchange integrations to enable (comma separated). Must exist in exchanges/infrastructure/catalog.py.
ENABLED_EXCHANGES=binance,binance-usdm
# Strategies to enable (comma separated TYPE_KEYs). Empty enables every strategy in strategies/catalog.py.
ENABLED_STRATEGIES=
DATABASE_URL=postgresql+asyncpg://lostcrypto:lostcrypto@localhost:5432/lostcrypto
# Live trading stays disabled. Do not enable outside a deliberate, reviewed setup.
# LIVE_TRADING_ENABLED=false

# --- Binance Demo credentials -------------------------------------------------------------
# Authentication: set JWT_SECRET (user login for the frontend; make jwt-secret) and/or API_TOKEN
# (a static token for scripts). At least one is required unless APP_ENV=local; endpoints that
# accept exchange keys need it always. Create the first admin with: make create-admin
JWT_SECRET=
API_TOKEN=
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=7
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_MINUTES=15
# Fernet key(s) encrypting stored exchange credentials (comma separated; first encrypts, all
# decrypt, so keys can be rotated). Generate one with: make master-key
CREDENTIAL_MASTER_KEYS=
# Real orders on Binance Demo/Testnet (fake money) are off until you turn this on for the worker.
TESTNET_TRADING_ENABLED=false
# Reconciliation with the exchange (seconds).
# RECONCILE_INTERVAL_SECONDS=60
# RECONCILE_ABSENT_AFTER_SECONDS=30
# NATIVE_STOP_POLL_SECONDS=10

# Stored candles kept current by the worker (only closed candles; seconds unless noted).
# CANDLE_UPDATE_ENABLED=true
# CANDLE_UPDATE_INTERVAL_SECONDS=30
# CANDLE_UPDATE_GRACE_SECONDS=5
# CANDLE_UPDATE_DISCOVER_SECONDS=600
# CANDLE_UPDATE_MAX_AGE_DAYS=7
# CANDLE_STALE_AFTER_CANDLES=3
# In-app alerts (seconds unless noted).
# ALERT_EVALUATION_SECONDS=15
# ALERT_COOLDOWN_SECONDS=300
# ALERT_RETENTION_DAYS=30
# ALERTS_API_EVALUATION_ENABLED=true

# --- Phase 5: LIVE TRADING (REAL MONEY). Everything below is off/unset by default. ---------
# Read docs/architecture/13-live-trading.md first. Needs APP_ENV=prod. Start with tiny caps.
LIVE_TRADING_ENABLED=false
# LIVE_MAX_ORDER_NOTIONAL=50      # quote currency, per order
# LIVE_MAX_TOTAL_EXPOSURE=200     # quote currency, all live positions
# LIVE_MAX_DAILY_LOSS=20          # quote currency, per bot per UTC day
# LIVE_MIN_PAPER_DAYS=7
# LIVE_REQUIRE_IP_RESTRICTION=true
# LIVE_APPROVAL_MINUTES=10
