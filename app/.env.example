# Base URL of the Lost Crypto API (public; goes to the browser). The API must list this app's
# origin in its CORS_ORIGINS, and in production both must share one registrable domain.
VITE_API_BASE_URL=http://localhost:8000/api/v1
# local | prod. Only labels the environment in the UI; the backend decides what is allowed.
VITE_APP_ENV=local
